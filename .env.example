# everteam environment — copy to .env.local and fill in. NEVER commit .env.local.
#
# The Gemini key is used server-side only (Butterbase edge function). The frontend
# never sees it. For local dev without Butterbase, you may point the app at the
# edge function URL once deployed.

# Butterbase backend (the deployed app the frontend calls)
VITE_BUTTERBASE_BASE_URL=
VITE_BUTTERBASE_APP_ID=

# EverMe / EverMind Cloud (hosted memory). Optional — app falls back to EverOS, then local.
# Get a key at console.evermind.ai. Base is the EverMind Cloud API host.
VITE_EVERME_BASE_URL=https://api.evermind.ai
VITE_EVERME_TOKEN=

# EverOS self-hosted fallback (only if running locally)
VITE_EVEROS_BASE_URL=http://localhost:1995

# Force a memory provider for testing: everme | everos | local  (default: auto)
VITE_MEMORY_PROVIDER=auto

# --- Server-side only (set in the Butterbase edge function env, NOT here) ---
# GEMINI_API_KEY=...        # free key from https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-flash-latest
